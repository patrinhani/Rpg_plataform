rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function estruturaMembrosValida(dados) {
      return dados.nome is string
        && dados.nome.size() > 0
        && dados.nome.size() <= 80
        && dados.mestre is string
        && dados.membroUids is list
        && dados.jogadores is list
        && dados.membroUids.size() == dados.membroUids.toSet().size()
        && dados.membroUids.size() == dados.jogadores.size()
        && dados.mestre in dados.membroUids;
    }

    function uidDeclaradoMembro(dados) {
      return autenticado()
        && dados.membroUids is list
        && request.auth.uid in dados.membroUids;
    }

    function membroDaMesa(dados) {
      return uidDeclaradoMembro(dados) && estruturaMembrosValida(dados);
    }

    function mestreDaMesa(dados) {
      return membroDaMesa(dados) && dados.mestre == request.auth.uid;
    }

    function campanhaVttDaMesa(dados) {
      return 'vtt' in dados
        && dados.vtt is map
        && 'campaignId' in dados.vtt
        && dados.vtt.campaignId is string
        ? dados.vtt.campaignId
        : 'caos-empty';
    }

    function criacaoGrantVttValida(grantId) {
      let mesa = get(
        /databases/$(database)/documents/mesas/$(request.resource.data.mesaId)
      ).data;
      return autenticado()
        && grantId.matches('^[A-Za-z0-9_-]{32,128}$')
        && request.resource.data.keys().hasOnly([
          'challenge',
          'mesaId',
          'uid',
          'role',
          'roomName',
          'campaignId',
          'issuedAt'
        ])
        && request.resource.data.challenge == grantId
        && request.resource.data.mesaId is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.issuedAt == request.time
        && membroDaMesa(mesa)
        && request.resource.data.roomName == mesa.nome
        && request.resource.data.campaignId.matches(
          '^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$'
        )
        && request.resource.data.campaignId == campanhaVttDaMesa(mesa)
        && request.resource.data.role == (
          mesa.mestre == request.auth.uid ? 'master' : 'player'
        );
    }

    function alterouSomente(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function criacaoDeMesaValida() {
      return autenticado()
        && estruturaMembrosValida(request.resource.data)
        && request.resource.data.mestre == request.auth.uid
        && request.resource.data.membroUids == [request.auth.uid]
        && request.resource.data.jogadores.size() == 1
        && request.resource.data.jogadores[0].keys().hasOnly(['uid', 'nome'])
        && request.resource.data.jogadores[0].uid == request.auth.uid
        && request.resource.data.jogadores[0].nome is string
        && request.resource.data.jogadores[0].nome.size() > 0
        && request.resource.data.jogadores[0].nome.size() <= 80;
    }

    // Exceção estreita para o convite por código: o documento da mesa não pode ser
    // lido antes da adesão. O usuário só pode acrescentar a si próprio, uma vez,
    // sem alterar mestre, VTT ou qualquer outro estado da mesa.
    function entradaPropriaValida() {
      let ultimoJogador = request.resource.data.jogadores[
        request.resource.data.jogadores.size() - 1
      ];
      return autenticado()
        && estruturaMembrosValida(resource.data)
        && estruturaMembrosValida(request.resource.data)
        && !(request.auth.uid in resource.data.membroUids)
        && alterouSomente(['membroUids', 'jogadores'])
        && request.resource.data.membroUids.size() == resource.data.membroUids.size() + 1
        && request.resource.data.membroUids.hasAll(resource.data.membroUids)
        && request.auth.uid in request.resource.data.membroUids
        && request.resource.data.jogadores.size() == resource.data.jogadores.size() + 1
        && request.resource.data.jogadores.hasAll(resource.data.jogadores)
        && ultimoJogador.keys().hasOnly(['uid', 'nome'])
        && ultimoJogador.uid == request.auth.uid
        && ultimoJogador.nome is string
        && ultimoJogador.nome.size() > 0
        && ultimoJogador.nome.size() <= 80;
    }

    function atualizacaoDoMestreValida() {
      return mestreDaMesa(resource.data)
        && estruturaMembrosValida(request.resource.data);
    }

    // Capacidade aleatoria e curta: o VTT pode ler um grant especifico, mas nao
    // recebe o token Firebase do usuario e nao pode enumerar grants existentes.
    match /vttAccessGrants/{grantId} {
      allow create: if criacaoGrantVttValida(grantId);
      allow get: if resource.data.issuedAt is timestamp
        && request.time < resource.data.issuedAt + duration.value(5, 'm');
      allow list, update: if false;
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if autenticado() && request.auth.uid == userId;

      match /{documento=**} {
        allow read, write: if autenticado() && request.auth.uid == userId;
      }
    }

    match /mesas/{mesaId} {
      allow create: if criacaoDeMesaValida();
      allow get: if membroDaMesa(resource.data);
      // A consulta do painel usa array-contains com o UID autenticado. Para list,
      // a regra precisa refletir exatamente esse filtro; validações estruturais
      // adicionais não podem ser usadas como filtro pelo Firestore.
      allow list: if autenticado()
        && request.auth.uid in resource.data.membroUids;
      // A iniciativa permanece no documento da mesa. Como uma regra não consegue
      // isolar com segurança um único item desse array, apenas o mestre pode
      // alterá-la; o jogador informa o resultado obtido com os dados físicos.
      allow update: if atualizacaoDoMestreValida()
        || entradaPropriaValida();
      allow delete: if mestreDaMesa(resource.data);

      match /personagens/{personagemUid} {
        function acessoAoPersonagemNaMesaValido() {
          let mesaPai = get(
            /databases/$(database)/documents/mesas/$(mesaId)
          ).data;
          return membroDaMesa(mesaPai)
            && (request.auth.uid == personagemUid || mestreDaMesa(mesaPai));
        }

        allow read, create, update, delete: if acessoAoPersonagemNaMesaValido();
      }

      match /criaturas/{criaturaId} {
        function mesaPaiCriatura() {
          return get(/databases/$(database)/documents/mesas/$(mesaId)).data;
        }

        function fichaCriaturaValida() {
          return request.resource.data.keys().hasOnly([
              'id', 'nome', 'elemento', 'vd', 'tipo', 'presenca', 'foto',
              'sentidos', 'iniciativa', 'defesa', 'fortitude', 'reflexos',
              'vontade', 'pv_max', 'pv_atual', 'machucado', 'resistencias',
              'vulnerabilidades', 'atributos', 'deslocamento', 'habilidades',
              'acoes', 'personalizada', 'atualizadaEm'
            ])
            && request.resource.data.id == criaturaId
            && criaturaId.matches('^criatura_[A-Za-z0-9_-]{8,90}$')
            && request.resource.data.nome is string
            && request.resource.data.nome.size() >= 2
            && request.resource.data.nome.size() <= 80
            && request.resource.data.elemento is string
            && request.resource.data.elemento.size() <= 50
            && request.resource.data.tipo is string
            && request.resource.data.tipo.size() <= 100
            && request.resource.data.foto is string
            && request.resource.data.foto.size() <= 350000
            && request.resource.data.iniciativa is string
            && request.resource.data.iniciativa.size() > 0
            && request.resource.data.pv_max is int
            && request.resource.data.pv_max > 0
            && request.resource.data.pv_max <= 9999
            && request.resource.data.atributos is map
            && request.resource.data.habilidades is list
            && request.resource.data.habilidades.size() <= 20
            && request.resource.data.acoes is list
            && request.resource.data.acoes.size() <= 20
            && request.resource.data.personalizada == true
            && request.resource.data.atualizadaEm == request.time;
        }

        allow read: if membroDaMesa(mesaPaiCriatura());
        allow create, update: if mestreDaMesa(mesaPaiCriatura())
          && fichaCriaturaValida();
        allow delete: if mestreDaMesa(mesaPaiCriatura());
      }
    }
  }
}
